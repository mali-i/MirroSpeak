{
  "name": "mirrospeak",
  "productName": "MirroSpeak",
  "version": "1.1.1",
  "description": "My Electron application description",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "package:dmg": "FORGE_OUT_DIR=out/dmg electron-forge package --platform=darwin",
    "package:mas": "FORGE_PLATFORM=mas FORGE_OUT_DIR=out/mas electron-forge package --platform=mas",
    "make": "electron-forge make",
    "make:dmg": "FORGE_OUT_DIR=out/dmg electron-forge make --platform=darwin --targets=@electron-forge/maker-dmg",
    "make:mas": "FORGE_PLATFORM=mas FORGE_OUT_DIR=out/mas electron-forge make --platform=mas --targets=@electron-forge/maker-pkg",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\""
  },
  "keywords": [],
  "author": {
    "name": "algernon",
    "email": "hello_mali_i@163.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mali-i/MirroSpeak.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-pkg": "^7.11.1",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@electron-forge/publisher-github": "^7.11.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@vitejs/plugin-vue": "^6.0.3",
    "autoprefixer": "^10.4.23",
    "electron": "39.8.9",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "vue": "^3.5.26"
  }
}
